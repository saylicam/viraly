# Copie ce fichier en .env pour le développement local.
# Sur Railway, ces valeurs se mettent dans l'onglet "Variables" du service.

# Clé Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase (identifie le projet pour vérifier les connexions)
FIREBASE_PROJECT_ID=viraly-01

# RevenueCat : clé SECRÈTE (commence par sk_), dans RevenueCat > Project settings > API keys
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
# "false" seulement pour tester en local sans abonnement
REQUIRE_SUBSCRIPTION=true

NODE_ENV=production
# Analyses offertes à un compte gratuit, au total (pas par jour)
FREE_ANALYSES_TOTAL=1

# --- Tendances de la semaine ---
# Clé SociaVault (https://sociavault.com) : collecte automatique une fois par semaine (~45 crédits)
SOCIAVAULT_API_KEY=
TRENDS_INTERVAL_DAYS=7
# Jeton secret de ton choix pour lancer une collecte à la main (POST /api/trends/refresh)
ADMIN_TOKEN=
# Compte de service Firebase (JSON complet) : stockage des tendances + notifications
FIREBASE_SERVICE_ACCOUNT=
