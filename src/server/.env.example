# Copie ce fichier en .env pour le développement local.
# Sur Railway, ces valeurs se mettent dans l'onglet "Variables" du service.

# Clé Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase (identifie le projet pour vérifier les connexions)
FIREBASE_PROJECT_ID=viraly-01

# RevenueCat : clé SECRÈTE (commence par sk_), dans RevenueCat > Project settings > API keys
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
# "false" seulement pour tester en local sans abonnement
REQUIRE_SUBSCRIPTION=true

NODE_ENV=production
