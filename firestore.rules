rules_version = '2';

// Règles publiées dans la console Firebase (projet viraly-01).
// Chaque utilisateur connecté ne peut lire/écrire QUE ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /calendar/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
